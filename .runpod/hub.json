{
  "title": "Qwen-Image-2.1 / Turbo Worker v0.0.1.2",
  "description": "Generate, edit, and create transparent images with the cached Qwen-Image-2.1 or Turbo checkpoint using one native Diffusers queue worker.",
  "type": "serverless",
  "category": "image",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 60,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80",
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0",
      "13.1",
      "13.2"
    ],
    "env": [
      {
        "key": "CPU_OFFLOAD",
        "input": {
          "name": "CPU offloading",
          "type": "string",
          "description": "Select offload strategy. 'text_encoder' retains the DiT and VAE on GPU; encoder weights also need space during conditioning. Profile the chosen GPU and request sizes.",
          "default": "text_encoder",
          "advanced": true,
          "options": [
            {
              "label": "Text Encoder Offload (Recommended)",
              "value": "text_encoder"
            },
            {
              "label": "Whole Model Offload",
              "value": "model"
            },
            {
              "label": "Sequential Offload",
              "value": "sequential"
            },
            {
              "label": "Disabled (All weights on GPU)",
              "value": "none"
            }
          ]
        }
      },
      {
        "key": "VAE_TILING",
        "input": {
          "name": "VAE tiling",
          "type": "boolean",
          "description": "Reduce decoding memory for large images.",
          "default": true,
          "trueValue": "true",
          "falseValue": "false",
          "advanced": true
        }
      },
      {
        "key": "HF_TOKEN",
        "input": {
          "name": "Hugging Face token (optional)",
          "type": "string",
          "description": "Optional download authentication. Leave empty for public access.",
          "default": "",
          "advanced": true
        }
      }
    ]
  }
}
